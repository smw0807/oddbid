# Copy to /opt/oddbid/server.env on the EC2 instance, owned by root, mode 600.
# Exact browser origins only. Separate multiple approved origins with commas.
# Do not use '*' or add preview domains unless intentionally approved.
ALLOWED_ORIGINS=https://oddbid.example.com

# NODE_ENV, HOST, PORT and APP_REVISION come from compose.yaml/update-server.sh.
# API_DOMAIN, CADDY_EMAIL and deployment state belong in /opt/oddbid/.env.
# Use the instance IAM role for AWS access. Never put AWS access keys here.
