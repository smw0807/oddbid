{
	email {$CADDY_EMAIL}
	# TCP 80/443 only; this deployment does not expose HTTP/3 UDP ports.
	servers {
		protocols h1 h2
	}
}

{$API_DOMAIN} {
	encode zstd gzip
	header {
		-Server
		X-Content-Type-Options nosniff
	}
	# Caddy handles WebSocket upgrades. Keep access logging off: Colyseus
	# connection URLs can include a reconnect token.
	reverse_proxy backend:2567
}
